# Machine profile: Berkeley server (34.182.123.41, ssh alias "berkeley"),
# deployed at /home/qian/vla_ws. 4x NVIDIA RTX PRO 6000 Blackwell Server
# Edition, ~98GB VRAM each, compute cap 12.0 -- confirmed via nvidia-smi
# 2026-09-02. Same GPU model as the GCP box in config/server.env.
#
# Sourced by docker/openvla_libero/run_eval.sh. Every line uses `: "${VAR:=...}"`
# so it only fills in a default -- any variable you've already exported in your
# shell wins (precedence: CLI args to run_eval.sh > exported env vars > this
# file > run_eval.sh's own fallback defaults).
#
# Usage: MACHINE_CONFIG=config/berkeley.env bash docker/openvla_libero/run_eval.sh --split spatial/default

# Plenty of VRAM -- full precision.
: "${LOAD_IN_4BIT:=False}"
: "${LOAD_IN_8BIT:=False}"

# 4 GPUs on this box. There are only 10 libero_spatial tasks, so more than 10
# GPUs would waste resources.
: "${GPUS:=0,1,2,3}"

# This box's GPUs are Blackwell-class (compute capability 12.0) -- the default
# cuda12.1 image's PyTorch build predates that architecture and will fail to
# run the model. Use docker/openvla_libero/Dockerfile.blackwell instead. That
# image also has no flash-attn wheel for this arch, hence sdpa below.
: "${IMAGE_NAME:=openvla-libero:blackwell}"
: "${OPENVLA_ATTN_IMPLEMENTATION:=sdpa}"

# Checkpoint lives inside this workspace on this machine (see
# openvla/checkpoint/), so no SERVER_ROOT bind mount is needed -- CHECKPOINT
# falls back to run_eval.sh's own in-workspace default.

: "${NUM_TRIALS_PER_TASK:=50}"
: "${SEED:=7}"
