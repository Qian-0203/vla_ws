# Machine profile: local laptop, 1x GPU.
#
# Sourced by docker/openvla_libero/run_eval.sh. Every line uses `: "${VAR:=...}"`
# so it only fills in a default -- any variable you've already exported in your
# shell wins (precedence: CLI args to run_eval.sh > exported env vars > this
# file > run_eval.sh's own fallback defaults).
#
# Usage: MACHINE_CONFIG=config/laptop.env bash docker/openvla_libero/run_eval.sh --split spatial/default

# This machine's GPU is small (commonly 8GB) -- a bf16 7B checkpoint (~15GB)
# will not fit, so default to 4-bit quantization.
: "${LOAD_IN_4BIT:=True}"
: "${LOAD_IN_8BIT:=False}"

# Single GPU: index 0. Comma-separate ("0,1") only if this machine ever gets more.
: "${GPUS:=0}"

# If this laptop's GPU is Blackwell-class (compute capability 12.0, e.g. RTX 50-series
# laptop GPUs) the cuda12.1 image's PyTorch build predates that architecture and will
# fail to run the model. Build docker/openvla_libero/Dockerfile.blackwell once
# (`docker build -f docker/openvla_libero/Dockerfile.blackwell -t openvla-libero:blackwell .`)
# and point IMAGE_NAME at it. That image also has no flash-attn wheel for this
# arch, hence sdpa below. Check your GPU with `nvidia-smi --query-gpu=compute_cap --format=csv`.
: "${IMAGE_NAME:=openvla-libero:blackwell}"
: "${OPENVLA_ATTN_IMPLEMENTATION:=sdpa}"

# Checkpoint lives inside this workspace on this machine (see openvla/checkpoint/).
: "${CHECKPOINT:=${WORKSPACE_ROOT}/openvla/checkpoint/baseline_lora_libero_spatial_4gpu_b24_run004/openvla-7b+libero_spatial_no_noops+b24+lr-0.0005+lora-r32+dropout-0.0--image_aug}"

: "${NUM_TRIALS_PER_TASK:=50}"
: "${SEED:=7}"
