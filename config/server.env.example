# Machine profile template for a remote GPU server. Copy to config/server.env
# and fill in SERVER_ROOT (and CHECKPOINT if it doesn't live under this
# workspace) for your specific box, then:
#   MACHINE_CONFIG=config/server.env bash docker/openvla_libero/run_eval.sh --split spatial/default
#
# Same override rule as laptop.env: CLI args to run_eval.sh > exported env vars
# > this file > run_eval.sh's own fallback defaults.

# Plenty of VRAM on a real GPU server -- run full precision.
: "${LOAD_IN_4BIT:=False}"
: "${LOAD_IN_8BIT:=False}"

# Server GPUs (comma-separated ids). run_eval.sh shards tasks round-robin across
# however many are listed here -- there are only 10 libero_spatial tasks, so
# more than 10 GPUs wastes resources.
: "${GPUS:=0,1,2,3,4}"

# Older-architecture image with flash-attn; matches the original 5xH200 setup.
: "${IMAGE_NAME:=openvla-libero:cuda12.1}"
: "${OPENVLA_ATTN_IMPLEMENTATION:=flash_attention_2}"

# If the checkpoint/datasets live outside this git workspace on the server (as
# they did on the original box), set SERVER_ROOT and it'll be bind-mounted
# read-only alongside the workspace.
: "${SERVER_ROOT:=/home/ec2-user/wenhan}"
: "${CHECKPOINT:=${SERVER_ROOT}/openvla/checkpoints/baseline_lora_libero_spatial_4gpu_b24_run004/openvla-7b+libero_spatial_no_noops+b24+lr-0.0005+lora-r32+dropout-0.0--image_aug}"

: "${NUM_TRIALS_PER_TASK:=50}"
: "${SEED:=7}"
