# Policy-server image for GR00T N1.5 (scripts/policy_servers/serve_gr00t.py). Not an eval image: no MuJoCo / LIBERO.
# Versions follow the pins in NVIDIA/Isaac-GR00T's pyproject.toml (n1.5-release) that the inference path imports; its
# `base` extra pins torch 2.5.1, which has no Blackwell kernels, so the torch is the 2.7.1 of the eval image. The Eagle
# backbone asks for flash-attention-2 (no Blackwell build); serve_gr00t.py switches it to SDPA.
FROM pytorch/pytorch:2.7.1-cuda12.8-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive PIP_NO_CACHE_DIR=1 PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip && python -m pip install \
    "transformers==4.51.3" "timm==1.0.14" "diffusers==0.30.2" "peft==0.17.0" "accelerate==1.2.1" \
    "einops==0.8.1" "pydantic==2.10.6" "numpydantic==1.6.7" "dm_tree==0.1.8" "gymnasium==1.0.0" \
    "av==12.3.0" "opencv_python_headless==4.11.0.86" "pandas==2.2.3" "pyarrow==14.0.1" "numpy==1.26.4" \
    "matplotlib" "tyro" "tqdm" "PyYAML" "requests" "safetensors" "huggingface_hub" "websockets" "msgpack" \
    "openpi-client @ git+https://github.com/Physical-Intelligence/openpi.git@215abfb217dbac7d5f1273282331b9b1866c0479#subdirectory=packages/openpi-client"
